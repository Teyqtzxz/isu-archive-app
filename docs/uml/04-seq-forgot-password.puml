@startuml 04-seq-forgot-password
' ISU Research Study E-Library - Sequence: Forgot password (final, main a7d5ed9)
' Checked against: src/components/ForgotPassword.tsx (send), src/data.ts
' (sendPasswordReset, linkReset, linkEmailOnThisBrowser), src/emailLink.ts
' (sendResetLink, shouldFallBack, createLinkReset), src/App.tsx (parseEmailAction,
' holdRouting), src/components/AuthActionScreen.tsx (openSignInLink, handleSave,
' saveWithLink)
' No real links, codes or email addresses are shown.
title Forgot password (email sign-in link, with fallback)
skinparam shadowing false
skinparam sequenceMessageAlign left
autonumber

actor "User\n(Student or Staff)" as User
participant "LoginScreen /\nForgotPassword" as FP
participant "data.ts" as Data
participant "emailLink.ts" as EL
participant "Firebase Authentication" as FA
participant "User's ISU mailbox" as Mail
participant "App.tsx" as App
participant "AuthActionScreen" as AAS
participant "Firebase's own\nreset page" as FBPage
database "localStorage" as LS

User -> FP : Forgot password? -> types ISU username
User -> FP : Send reset link
FP -> FP : checkEmail() (adds @isu.edu.ph)
FP -> Data : sendPasswordReset(email)
Data -> EL : sendResetLink(email, steps)
EL -> FA : sendSignInLinkToEmail(email,\n{url: app, handleCodeInApp: true})

alt sign-in link sent (normal case)
  FA --> EL : ok
  EL -> LS : rememberEmail()  key "isu.resetLinkEmail" {email, at}
  FA -> Mail : email "Sign in to ISU Research Study E-Library"\n(Firebase's fixed wording)
else send refused (e.g. free plan limit: 5 sign-in-link emails per day,\nor Email link turned off) - shouldFallBack() is true
  FA --> EL : error code (only the code is logged)
  EL -> LS : forgetEmail()
  EL -> FA : sendPasswordResetEmail(email, {url: app})
  FA -> Mail : Firebase's normal password reset email
else network-request-failed / invalid-email / missing-email
  FA --> EL : error
  EL --> FP : thrown -> message under the form (no fallback)
end
EL --> Data : "link" | "reset"
Data --> FP : done
FP -> User : "Check your ISU inbox"\n(same text whether or not the account exists)

== Normal case: the sign-in link opens the app ==
User -> Mail : open the email, click the link
Mail -> App : app opens with the sign-in link
App -> App : parseEmailAction(href) = {kind: "sign-in"}\nholdRouting = true (no dashboard routing)
App -> AAS : <AuthActionScreen mode="signIn" signInHref=href>
AAS -> Data : isFirebaseSignInLink(href)\nsignedInEmailWhenReady()
AAS -> LS : linkEmailOnThisBrowser()
alt email kept on this browser
  AAS -> User : "Create a new password" (live checklist, Confirm password)
else not kept (other browser / phone)
  AAS -> User : "Confirm your ISU email" -> then "Create a new password"
end
User -> AAS : new password + confirm, Save password
AAS -> AAS : checkNewPassword(), checkConfirm()
AAS -> Data : linkReset(href).save(email, password)
Data -> FA : setPersistence(inMemoryPersistence)
Data -> FA : signInWithEmailLink(email, href)
alt link expired / used / wrong email / isNewUser (no account)
  Data -> FA : deleteUser() only if a new account was just made
  Data --> AAS : {kind: "unusable"}
  AAS -> User : "This link no longer works" -> Send a new link
else signed in to the existing account
  Data -> FA : updatePassword(user, password)
  Data -> FA : signOut(), setPersistence(indexedDBLocalPersistence)
  Data -> LS : forgetEmail()
  Data --> AAS : {kind: "saved"}
  AAS -> User : "Password changed" -> Sign in
end
User -> FP : Sign in with ISU username + new password\n(same uid and role)

== Fallback case: the reset email ==
User -> Mail : open the reset email, click the link
Mail -> FBPage : link opens Firebase's plain page\n(action URL cannot be changed on this project)
User -> FBPage : type new password, Save
FBPage -> FA : password set
User -> FP : Sign in with ISU username + new password
@enduml
